   "source": [
    "def missing_number(nums):\n",
    "    n = max(nums)\n",
    "    expected_sum = n * (n + 1) // 2\n",
    "    actual_sum = sum(nums)\n",
    "    return expected_sum - actual_sum\n",
    "\n",
    "\n",
    "nums = eval(input())\n",
    "print(missing_number(nums))"
   ]
  }
