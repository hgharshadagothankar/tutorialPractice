   "source": [
    "# given a number find sum of even factors\n",
    "\n",
    "def sum_of_even_factors(n):\n",
    "    total = 0\n",
    "    for i in range(1, n + 1):\n",
    "        if n % i == 0 and i % 2 == 0:\n",
    "            total += i\n",
    "    return total\n",
    "\n",
    "n = int(input())\n",
    "print(sum_of_even_factors(n))"
   ]
  }
 ],
