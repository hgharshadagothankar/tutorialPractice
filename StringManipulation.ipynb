   "source": [
    "text = input()\n",
    "\n",
    "words = text.split()\n",
    "\n",
    "for i in range(len(words)):\n",
    "    if i % 2 == 0:\n",
    "        words[i] = words[i].lower()\n",
    "    else:\n",
    "        words[i] = words[i].upper()\n",
    "\n",
    "print(\" \".join(words))"
   ]
  }
