    "#write fibinacci series\n",
    "# First two numbers\n",
    "a = 0\n",
    "b = 1\n",
    "\n",
    "# Print first two numbers\n",
    "print(a)\n",
    "print(b)\n",
    "\n",
    "# Print next 3 numbers\n",
    "for i in range(3):\n",
    "    c = a + b\n",
    "    print(c)\n",
    "    a = b\n",
    "    b = c\n"
   ]
  }
