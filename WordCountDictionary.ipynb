   "source": [
    "s = input(\"Enter a string: \")\n",
    "\n",
    "s = s.lower()          # convert to lowercase\n",
    "words = s.split()      # split into words\n",
    "\n",
    "count = {}\n",
    "\n",
    "for word in words:\n",
    "    if word in count:\n",
    "        count[word] += 1\n",
    "    else:\n",
    "        count[word] = 1\n",
    "\n",
    "print(count)"
   ]
  }
 ],
