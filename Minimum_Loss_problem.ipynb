   "source": [
    "n = int(input())\n",
    "prices = list(map(int, input().split()))\n",
    "\n",
    "min_loss = float('inf')\n",
    "\n",
    "for i in range(n):\n",
    "    for j in range(i+1, n):\n",
    "        if prices[i] > prices[j]:\n",
    "            loss = prices[i] - prices[j]\n",
    "            min_loss = min(min_loss, loss)\n",
    "\n",
    "print(min_loss)"
   ]
  }
 ],
