   "source": [
    "def second_largest(nums):\n",
    "    nums = list(set(nums))   # remove duplicates\n",
    "    if len(nums) < 2:\n",
    "        return None\n",
    "    nums.sort()\n",
    "    return nums[-2]\n",
    "\n",
    "nums = eval(input())\n",
    "result = second_largest(nums)\n",
    "print(result)"
   ]
  }
