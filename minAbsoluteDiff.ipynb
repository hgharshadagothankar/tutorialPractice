   "source": [
    "nums = eval(input())\n",
    "\n",
    "def find_min_abs_diff(nums):\n",
    "    nums.sort()\n",
    "    min_diff = float('inf')\n",
    "\n",
    "    for i in range(len(nums)-1):\n",
    "        diff = abs(nums[i] - nums[i+1])\n",
    "        if diff < min_diff:\n",
    "            min_diff = diff\n",
    "\n",
    "    return min_diff\n",
    "\n",
    "print(find_min_abs_diff(nums))"
   ]
  }
