   "source": [
    "def find_max_key(my_dict):\n",
    "    max_key = max(my_dict, key=my_dict.get)\n",
    "    return max_key\n",
    "\n",
    "\n",
    "my_dict = eval(input())\n",
    "print(find_max_key(my_dict))"
   ]
  }
