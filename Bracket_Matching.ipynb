   "source": [
    "s = input()\n",
    "\n",
    "stack = []\n",
    "pairs = {')': '(', ']': '[', '}': '{'}\n",
    "\n",
    "for char in s:\n",
    "    if char in pairs:\n",
    "        if not stack or stack.pop() != pairs[char]:\n",
    "            print(False)\n",
    "            break\n",
    "    else:\n",
    "        stack.append(char)\n",
    "else:\n",
    "    print(len(stack) == 0)"
   ]
  }
